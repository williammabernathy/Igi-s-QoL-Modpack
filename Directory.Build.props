<Project>
  <!--
    Shared build settings for every mod in this repo.
    Override the game path per machine with:  dotnet build -p:GameDir="/path/to/Vanguard Galaxy"
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">/mnt/data/SteamLibrary/steamapps/common/Vanguard Galaxy</GameDir>
    <ManagedDir>$(GameDir)/VanguardGalaxy_Data/Managed</ManagedDir>
    <BepInExDir>$(GameDir)/BepInEx</BepInExDir>

    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <!-- Deploy into the game after every build. Disable with -p:DeployToGame=false -->
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Publicize="true" strips access modifiers at compile time so private game fields/methods can be used directly. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExDir)/core/BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/core/0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)/Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="$(ManagedDir)/UnityEngine*.dll;$(ManagedDir)/Unity.InputSystem.dll;$(ManagedDir)/Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BepInExDir)/plugins/$(AssemblyName)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(AssemblyName) -> $(BepInExDir)/plugins/$(AssemblyName)" />
  </Target>

  <!--
    Keep a copy of the game assemblies each build compiles against, in game-versions/<game version>-<hash>/, so the
    previous version is still around after Steam updates the game. tools/VersionDiff compares two of these folders.
    Runs before compiling, so a build that fails against a new game version still saves it.
  -->
  <Target Name="SnapshotGameAssemblies" BeforeTargets="BeforeBuild">
    <GetFileHash Files="$(ManagedDir)/Assembly-CSharp.dll">
      <Output TaskParameter="Hash" PropertyName="GameAssemblyHash" />
    </GetFileHash>
    <PropertyGroup>
      <GameVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(GameDir)/VanguardGalaxy_Data/globalgamemanagers')), '\b\d+\.\d+\.\d+(\.\d+)?\b').Value)</GameVersion>
      <GameSnapshotDir>$(MSBuildThisFileDirectory)game-versions/$(GameVersion)-$(GameAssemblyHash.Substring(0, 8).ToLowerInvariant())</GameSnapshotDir>
    </PropertyGroup>
    <ItemGroup>
      <GameSnapshotFile Include="$(ManagedDir)/Assembly-CSharp.dll;$(ManagedDir)/UnityEngine*.dll;$(ManagedDir)/Unity.InputSystem.dll;$(ManagedDir)/Unity.TextMeshPro.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GameSnapshotFile)" DestinationFolder="$(GameSnapshotDir)" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(GameSnapshotDir)/managed-dir.txt" Lines="$(ManagedDir)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
